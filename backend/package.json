    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1138.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0"
  }
