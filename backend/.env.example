# Modele de configuration du serveur MailFind.
# Copier en backend/.env et remplir. Le fichier .env n'est jamais versionne.
# Les decisions derriere ces valeurs sont dans docs/decisions.md.

# ---------------------------------------------------------------------------
# Environnement
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Origine de l'application web, utilisee par CORS et par les redirections OAuth.
APP_URL=http://localhost:5173
API_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Base de donnees, Neon (D-04)
# ---------------------------------------------------------------------------
# Hote groupe pour l'application : le nom contient "-pooler".
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.us-east-1.aws.neon.tech/mailfind?sslmode=verify-full
# Hote direct pour les migrations : sans "-pooler". Un pgbouncer ne sait pas
# executer un verrou consultatif ni un ordre DDL en transaction longue.
DIRECT_DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/mailfind?sslmode=verify-full

# ---------------------------------------------------------------------------
# Redis (D-05)
# ---------------------------------------------------------------------------
# BullMQ utilise ioredis, les sessions utilisent node-redis. Les deux clients ne
# sont pas interchangeables : les melanger est une panne connue.
REDIS_URL=redis://default:password@redis-xxxxx.c123.us-east-1-2.ec2.redns.redis-cloud.com:12345
# Prefixes obligatoires. Ils isolent MailFind meme si la base est partagee avec
# une autre application.
REDIS_SESSION_PREFIX=mailfind:sess:
BULLMQ_PREFIX=mailfind:bull

# ---------------------------------------------------------------------------
# Secrets de l'application
# ---------------------------------------------------------------------------
# Cookie de session. 32 octets aleatoires au moins.
SESSION_SECRET=
# Chiffrement AES-256-GCM des secrets au repos, jetons de fournisseurs et
# jeton d'integration Campaign Mailer (S-01). 32 octets en hexadecimal :
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
# Pendant une rotation, l'ancienne cle : elle dechiffre encore ce qu'elle a
# chiffre, la nouvelle chiffre tout ce qui s'ecrit. A vider quand le cache a
# expire (30 jours).
ENCRYPTION_KEY_PREVIOUS=

# ---------------------------------------------------------------------------
# Connexion Google, portees d'identite uniquement (D-11)
# ---------------------------------------------------------------------------
# Portees demandees : openid, email, profile. Jamais de portee Gmail.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ---------------------------------------------------------------------------
# Stockage des exports, Cloudflare R2 (D-06)
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mailfind-exports
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# Duree de vie d'un export, en jours (F-1104).
EXPORT_RETENTION_DAYS=7

# ---------------------------------------------------------------------------
# Fournisseurs
# ---------------------------------------------------------------------------
# Recherche du site officiel (D-07). Vide desactive la recherche web : le
# pipeline se rabat sur le domaine fourni dans le CSV.
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_BASE_URL=https://api.search.brave.com
# Requetes offertes chaque mois par Brave (D-13 : rien de payant). Au-dela, la
# recherche du site officiel s'arrete pour tous jusqu'au mois suivant.
BRAVE_MONTHLY_FREE_QUERIES=1000
# Enrichissement et verification de boite (D-08). Vide desactive le fournisseur :
# seules les verifications locales s'appliquent.
HUNTER_API_KEY=
HUNTER_BASE_URL=https://api.hunter.io
# Les 30 credits mensuels reserves a la recherche par domaine (D-14), et les 20
# autres de la formule gratuite a la verification de boite (un demi-credit par
# adresse, seulement quand l'import la demande).
HUNTER_MONTHLY_SEARCH_CREDITS=30
HUNTER_MONTHLY_VERIFICATION_CREDITS=20
# Ordre de repli des fournisseurs d'enrichissement (F-603), separes par des
# virgules. Un fournisseur n'est appele que s'il manque encore un type
# d'adresse recherche.
PROVIDER_ORDER=hunter
# Identification legale des entreprises francaises (D-10). Gratuite, sans cle.
RECHERCHE_ENTREPRISES_BASE_URL=https://recherche-entreprises.api.gouv.fr
# Domaines d'adresses jetables (niveau 4 de 6.7), liste publique rechargee
# chaque semaine par le processus de traitement.
DISPOSABLE_DOMAINS_URL=https://raw.githubusercontent.com/disposable-email-domains/disposable-email-domains/main/disposable_email_blocklist.conf

# ---------------------------------------------------------------------------
# Budget et quotas (D-13, D-14)
# ---------------------------------------------------------------------------
# Plafond global de depense fournisseurs, en euros par mois. 0 signifie que
# rien de payant n'est jamais appele : au bout des credits offerts, le pipeline
# continue sans le fournisseur et marque les entreprises concernees.
PROVIDER_MONTHLY_BUDGET_EUR=0

QUOTA_COMPANIES_PER_USER_PER_MONTH=500
QUOTA_WEB_SEARCHES_PER_USER_PER_MONTH=80
QUOTA_PROVIDER_SEARCHES_PER_USER_PER_MONTH=3
QUOTA_MAILBOX_VERIFICATIONS_PER_USER_PER_MONTH=4
QUOTA_EXPORTS_PER_USER_PER_MONTH=50
QUOTA_CONCURRENT_IMPORTS_PER_USER=2

# ---------------------------------------------------------------------------
# Agent de collecte (F-403 a F-405)
# ---------------------------------------------------------------------------
# L'agent est identifie et joignable. Ne jamais se faire passer pour un
# navigateur.
CRAWLER_USER_AGENT=MailFindBot/0.1 (+https://mailfind.app/bot)
CRAWLER_REQUESTS_PER_SECOND_PER_DOMAIN=1
CRAWLER_REQUEST_TIMEOUT_MS=10000
CRAWLER_MAX_RESPONSE_BYTES=3000000
CRAWLER_MAX_REDIRECTS=5

# ---------------------------------------------------------------------------
# Campaign Mailer (D-01, Phase 7)
# ---------------------------------------------------------------------------
CAMPAIGN_MAILER_API_URL=
CAMPAIGN_MAILER_INTEGRATION_TOKEN=

# ---------------------------------------------------------------------------
# Observabilite
# ---------------------------------------------------------------------------
# Vide en developpement. Aucune adresse ni jeton n'est envoye a Sentry (S-03).
SENTRY_DSN=
