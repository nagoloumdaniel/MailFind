# Normalize line endings: LF in the repository, native in the working copy.
# Without this, the repository mixes CRLF from Windows checkouts with LF from
# Linux CI, and every diff shows whole files as changed.
* text=auto eol=lf

# Files that must keep LF even on Windows, because the tools that read them
# reject CR.
*.sh text eol=lf
*.bash text eol=lf
Dockerfile text eol=lf
*.dockerfile text eol=lf
.env.example text eol=lf

# Windows scripts must keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files: never convert, never diff as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.avif binary
*.pdf binary
*.docx binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.zip binary
*.gz binary

# Lockfiles: keep them out of diffs and out of merge conflicts by hand.
package-lock.json -diff linguist-generated=true
