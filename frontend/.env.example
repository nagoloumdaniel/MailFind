# Modele de configuration de l'application web MailFind.
# Copier en frontend/.env et remplir. Tout ce qui est prefixe VITE_ finit dans
# le paquet envoye au navigateur : aucun secret ici, jamais.

# Base des appels a l'API. Vide en developpement : le proxy de Vite renvoie
# /api vers http://localhost:3000, ce qui garde les cookies sur la meme origine.
VITE_API_BASE_URL=

# Vide en developpement.
VITE_SENTRY_DSN=
