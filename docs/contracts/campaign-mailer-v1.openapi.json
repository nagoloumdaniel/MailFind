{
  "openapi": "3.1.0",
  "info": {
    "title": "Campaign Mailer v1 API",
    "version": "1.0.0",
    "description": "For MailFind: create a draft campaign with its contacts, then add contacts to it. A campaign created here stays a draft; only its owner launches it, from the web app. Authenticate with `Authorization: Bearer cm_...`, a personal integration token created on the account page. 60 requests a minute per token (RateLimit-* headers)."
  },
  "servers": [
    {
      "url": "https://campaignmailer.vercel.app/api/v1"
    }
  ],
  "security": [
    {
      "integrationToken": []
    }
  ],
  "paths": {
    "/campaigns": {
      "post": {
        "operationId": "createDraftCampaign",
        "summary": "Create a draft campaign with its contacts",
        "x-scope": "campaigns:write",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "description": "Required. The same key replays the first response for 24 hours, so a batch sent again after a lost answer is not imported twice.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "prospection",
                      "relance",
                      "marketing",
                      "alternance",
                      "autre"
                    ]
                  },
                  "contacts": {
                    "default": [],
                    "maxItems": 2000,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "email": {
                          "type": "string",
                          "maxLength": 400
                        },
                        "contact_name": {
                          "type": "string",
                          "maxLength": 400
                        },
                        "company_name": {
                          "type": "string",
                          "maxLength": 400
                        },
                        "salutation": {
                          "type": "string",
                          "maxLength": 400
                        },
                        "source_url": {
                          "type": "string",
                          "maxLength": 2000,
                          "format": "uri"
                        },
                        "verification_status": {
                          "type": "string",
                          "enum": [
                            "valid",
                            "accept_all",
                            "risky",
                            "unknown",
                            "unverified"
                          ]
                        },
                        "verified_at": {
                          "type": "string",
                          "format": "date-time",
                          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                        }
                      },
                      "required": [
                        "email"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "name"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created. The contacts rejected by the import rules are in the report.",
            "headers": {
              "Idempotent-Replayed": {
                "description": "true when this is the replay of the first response.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid body, or no Idempotency-Key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, unknown or revoked token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Scope missing, or current terms not accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "A request under this key is still running, or the campaign is no longer a draft",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "This Idempotency-Key was used for another request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests: see Retry-After",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/campaigns/{id}/contacts": {
      "post": {
        "operationId": "addContactsToDraft",
        "summary": "Add contacts to a draft",
        "description": "Addresses already in the campaign are reported as already_imported.",
        "x-scope": "contacts:write",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "description": "Required. The same key replays the first response for 24 hours, so a batch sent again after a lost answer is not imported twice.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "contacts": {
                    "minItems": 1,
                    "maxItems": 2000,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "email": {
                          "type": "string",
                          "maxLength": 400
                        },
                        "contact_name": {
                          "type": "string",
                          "maxLength": 400
                        },
                        "company_name": {
                          "type": "string",
                          "maxLength": 400
                        },
                        "salutation": {
                          "type": "string",
                          "maxLength": 400
                        },
                        "source_url": {
                          "type": "string",
                          "maxLength": 2000,
                          "format": "uri"
                        },
                        "verification_status": {
                          "type": "string",
                          "enum": [
                            "valid",
                            "accept_all",
                            "risky",
                            "unknown",
                            "unverified"
                          ]
                        },
                        "verified_at": {
                          "type": "string",
                          "format": "date-time",
                          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                        }
                      },
                      "required": [
                        "email"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "contacts"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created. The contacts rejected by the import rules are in the report.",
            "headers": {
              "Idempotent-Replayed": {
                "description": "true when this is the replay of the first response.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid body, or no Idempotency-Key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, unknown or revoked token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Scope missing, or current terms not accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No such campaign for this account",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "A request under this key is still running, or the campaign is no longer a draft",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "This Idempotency-Key was used for another request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests: see Retry-After",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ImportResponse": {
        "type": "object",
        "properties": {
          "campaign": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "name": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "prospection",
                  "relance",
                  "marketing",
                  "alternance",
                  "autre"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "draft",
                  "scheduled",
                  "running",
                  "paused",
                  "completed"
                ]
              },
              "url": {
                "type": "string",
                "description": "Where the owner finds the draft, in the web app."
              }
            },
            "required": [
              "id",
              "name",
              "type",
              "status",
              "url"
            ],
            "additionalProperties": false
          },
          "report": {
            "type": "object",
            "properties": {
              "read": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "imported": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991,
                "description": "What the database actually took."
              },
              "rejected": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "line": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "email": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string",
                      "enum": [
                        "invalid_email",
                        "duplicate_in_file",
                        "already_imported"
                      ]
                    }
                  },
                  "required": [
                    "line",
                    "email",
                    "reason"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "read",
              "imported",
              "rejected"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "campaign",
          "report"
        ],
        "additionalProperties": false
      },
      "Error": {
        "$ref": "#/components/schemas/Error"
      }
    },
    "securitySchemes": {
      "integrationToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Personal integration token. Scopes: campaigns:write, contacts:write."
      }
    }
  }
}
